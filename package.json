{
  "name": "stock-scraper",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run updateWs && node --require ./preload.js src/index.js && npm run prettyStock",
    "uyw": "npm run updateWs && node --require ./preload.js src/updateYahooWsj.js && npm run prettyStock",
    "upup": "npm run updateWs && node --require ./preload.js src/updateAnalysts.js && npm run prettyStock",
    "extra": "npm run updateWs && node --require ./preload.js src/scrapeExtraData.js && npm run prettyStock",
    "test": "npm run updateWs && node --require ./preload.js test/puppeteerSandbox.js",
    "launch": "/Applications/Google\\ Chrome.app/Contents/MacOS/Google\\ Chrome --remote-debugging-port=9222 --no-first-run --no-default-browser-check",
    "updateWs": "curl localhost:9222/json/version > ws.json",
    "haleakala": "npm run updateWs && node --require ./preload.js test/haleakala.js",
    "prettyStock": "prettier --write ./test/stockData.json"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.0.0-rc.5",
    "himalaya": "^1.1.0",
    "jest": "^26.6.3",
    "lodash": "^4.17.20",
    "merge-img": "^2.1.3",
    "moment": "^2.29.1",
    "node-fetch": "^2.6.1",
    "puppeteer-core": "^7.1.0"
  },
  "devDependencies": {
    "eslint": "^7.21.0"
  },
  "eslintConfig": {
    "env": {
      "es2021": true,
      "node": true,
      "jest": true
    },
    "globals": {
      "_": true,
      "fs": true,
      "fetch": true,
      "ARGUS_ANALYST_KEY": true,
      "ARGUS_RESEARCH_KEY": true,
      "ZACKS_KEY": true,
      "XPATH_TIMEOUT": true,
      "FIDELITY": true,
      "FORD": true,
      "NEW_CONSTRUCTS": true,
      "THE_STREET": true,
      "ARGUS_ANALYST": true,
      "ARGUS_RESEARCH": true,
      "ZACKS": true,
      "MORNINGSTAR": true,
      "CFRA": true,
      "BOA": true,
      "SCRAPBOOK_LOCATION": true,
      "PAUSE_MS": true,
      "STOCK_DATA_LOCATION": true,
      "STOCK_DATA_BACKUP_LOCATION": true,
      "YAHOO_MODULES": true,
      "CONNECTION": true,
      "FIDELITY_STATS": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "rules": {
      "no-console": "off"
    }
  },
  "prettier": {
    "singleQuote": false,
    "semi": false,
    "printWidth": 90,
    "arrowParens": "avoid"
  }
}
