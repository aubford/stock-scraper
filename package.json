{
  "name": "stock-scraper",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run updateWs && node --require ./preload.js src/index.js",
    "updateYahooWsj": "npm run updateWs && node --require ./preload.js src/updateYahooWsj.js",
    "updateAnalysts": "npm run updateWs && node --require ./preload.js src/updateAnalysts.js",
    "extra": "npm run updateWs && node --require ./preload.js src/scrapeExtraData.js",
    "test": "npm run updateWs && node --require ./preload.js test/puppeteerSandbox.js",
    "launch": "/Applications/Google\\ Chrome.app/Contents/MacOS/Google\\ Chrome --remote-debugging-port=9222 --no-first-run --no-default-browser-check",
    "updateWs": "curl localhost:9222/json/version > ws.json",
    "haleakala": "npm run updateWs && node --require ./preload.js test/haleakala.js",
    "stock-tool": "node --require lodash test/stock_tool.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.0.0-rc.5",
    "himalaya": "^1.1.0",
    "jest": "^26.6.3",
    "lodash": "^4.17.20",
    "merge-img": "^2.1.3",
    "moment": "^2.29.1",
    "node-fetch": "^2.6.1",
    "puppeteer-core": "^7.1.0"
  },
  "devDependencies": {
    "eslint": "^7.21.0"
  },
  "eslint": {
    "env": {
      "es2021": true,
      "node": true,
      "jest": true
    },
    "globals": [
      "_",
      "fetch",
      "ARGUS_ANALYST_KEY",
      "ARGUS_RESEARCH_KEY",
      "ZACKS_KEY",
      "XPATH_TIMEOUT",
      "FIDELITY",
      "FORD",
      "NEW_CONSTRUCTS",
      "THE_STREET",
      "ARGUS_ANALYST",
      "ARGUS_RESEARCH",
      "ZACKS",
      "MORNINGSTAR",
      "CFRA",
      "BOA",
      "SCRAPBOOK_LOCATION",
      "PAUSE_MS",
      "STOCK_DATA_LOCATION",
      "STOCK_DATA_BACKUP_LOCATION",
      "YAHOO_MODULES"
    ],
    "extends": [
      "eslint:recommended"
    ],
    "rules": {
      "no-console": "off"
    }
  },
  "prettier": {
    "singleQuote": false,
    "semi": false,
    "printWidth": 100,
    "arrowParens": "avoid"
  }
}
