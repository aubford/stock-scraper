{
  "name": "stock-scraper",
  "version": "1.0.0",
  "description": "",
  "main": "src/apps/start.js",
  "scripts": {
    "commit": "mv $STOCK_SCRAPBOOK_LOCATION/stockDataStaging.json $STOCK_SCRAPBOOK_LOCATION/stockData.json",
    "all": "npm run extra && npm run csv && npm run update && npm run voo && npm run vooB",
    "daily-update": "caffeinate & jest ./test/historicalPrices.test.js && node --require ./preload.js ./src/apps/dailyUpdate.js && npm run prettyStock && killall caffeinate",
    "daily-update-dataroma": "caffeinate & jest ./test/historicalPrices.test.js && node --require ./preload.js ./src/apps/dailyUpdate.js --dataroma && npm run prettyStock && killall caffeinate",
    "voo-daily-update": "caffeinate & jest ./test/historicalPrices.test.js & node --require ./preload.js ./src/apps/dailyUpdate.js --voo && npm run prettyVoo && killall caffeinate",
    "update": "node --require ./preload.js src/apps/update.js",
    "csv": "node --require ./preload.js ./src/csv/processCSVs.js && npm run prettyStock",
    "init": "npm i; ln -s \"$STOCK_SCRAPBOOK_LOCATION/stockData.json\" ./stockData.json; ln -s \"$STOCK_SCRAPBOOK_LOCATION/stockDataMeta.json\" ./stockDataMeta.json; ln -s \"$STOCK_SCRAPBOOK_LOCATION/vooData.json\" ./vooData.json",
    "voo": "node --require ./preload.js src/apps/voo/fetchVoo.js && npm run prettyVoo",
    "vooB": "node --require ./preload.js src/apps/voo/fetchVooB.js && npm run prettyVoo",
    "launch": "node ./launch.js",
    "show": "node --require ./preload.js ./src/database/showTickers.js",
    "check-for-missing": "node ./src/csv/check-for-missing.js",
    "check": "node --eval \"console.log(require('$STOCK_SCRAPBOOK_LOCATION/stockData.json')[process.argv[1]])\"",
    "checkv": "node --eval \"console.log(require('$STOCK_SCRAPBOOK_LOCATION/vooData.json')[process.argv[1]])\"",
    "add-tickers": "node --require ./preload.js ./src/database/addTickers.js && npm run prettyStock",
    "voo-update-tickers": "node --require ./preload.js ./src/apps/voo/fetch-tickers.js",
    "prune-tickers": "node --require ./preload.js ./src/database/pruneTickers.js && npm run prettyStock && npm run check-for-missing",
    "prettyStock": "prettier --write \"$STOCK_SCRAPBOOK_LOCATION/stockData.json\"",
    "prettyVoo": "prettier --write \"$STOCK_SCRAPBOOK_LOCATION/vooData.json\"",
    "start": "node --require ./preload.js ./src/apps/start.js && npm run prettyStock",
    "test": "jest",
    "update-wsj-subset": "node --require ./preload.js ./src/apps/updateWsj.js --subset && npm run prettyStock",
    "update-fidelity": "node --require ./preload.js ./src/apps/updateFidelity.js && npm run prettyStock",
    "update-merill": "node --require ./preload.js ./src/apps/updateMerill.js && npm run prettyStock",
    "update-zacks": "node --require ./preload.js ./src/apps/updateZacks.js && npm run prettyStock",
    "voo-update-zacks": "node --require ./preload.js src/apps/voo/updateZacksForVoo.js && npm run prettyStock",
    "extra": "node --require ./preload.js ./src/apps/scrapeExtraData.js && npm run prettyStock",
    "test-historical-prices": "jest ./test/historicalPrices.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/jest": "^26.0.21",
    "chalk": "^4.1.0",
    "cheerio": "^1.0.0-rc.5",
    "csv-parser": "^3.0.0",
    "himalaya": "^1.1.0",
    "jest": "^29.6.2",
    "jsdom": "^21.0.0",
    "lodash": "^4.17.21",
    "merge-img": "^2.1.3",
    "moment": "^2.29.4",
    "open": "^8",
    "puppeteer-core": "^18.0.5"
  },
  "devDependencies": {
    "eslint": "^7.21.0"
  },
  "eslintConfig": {
    "env": {
      "es2021": true,
      "node": true,
      "jest": true
    },
    "globals": {
      "ARGUS_ANALYST_TIMEOUT": true,
      "BOA_TIMEOUT": true,
      "CFRA_TIMEOUT": true,
      "CONNECTION": true,
      "CacheService": true,
      "XPATH_TIMEOUT": true,
      "WSJ_TIMEOUT": true,
      "DEFAULT_NAVIGATION_TIMEOUT": true,
      "FIDELITY_ANALYST_TIMEOUT": true,
      "META_LOCATION": true,
      "MOODYS_TIMEOUT": true,
      "MORNINGSTAR_TIMEOUT": true,
      "NEW_CONSTRUCTS_TIMEOUT": true,
      "PAUSE_MS": true,
      "SCRAPBOOK_LOCATION": true,
      "STOCK_DATA_BACKUP_LOCATION": true,
      "STOCK_DATA_LOCATION": true,
      "STOCK_DATA_STAGING": true,
      "VOO_DATA_STAGING": true,
      "SpreadsheetApp": true,
      "TD_TIMEOUT": true,
      "TIPRANKS_TIMEOUT": true,
      "VOO_LOCATION": true,
      "fetch": true,
      "fs": true,
      "test": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "rules": {
      "no-console": "off",
      "no-unused-vars": "warn"
    }
  },
  "prettier": {
    "singleQuote": false,
    "semi": false,
    "printWidth": 95,
    "arrowParens": "avoid"
  }
}
