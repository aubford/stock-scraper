{
  "name": "stock-scraper",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "launch": "node ./launch.js",
    "app": "caffeinate & jest ./test/historicalPrices.test.js && node src/index.js && npm run prettyStocks && npm run check-for-missing && killall caffeinate",
    "all": "caffeinate & jest ./test/historicalPrices.test.js && node src/all.js && npm run prettyStocks && npm run check-for-missing && killall caffeinate",
    "init": "npm i; ln -s \"$STOCK_SCRAPBOOK_LOCATION/stockData.json\" ./stockData.json; ln -s \"$STOCK_SCRAPBOOK_LOCATION/stockDataMeta.json\" ./stockDataMeta.json; ln -s \"$STOCK_SCRAPBOOK_LOCATION/vooData.json\" ./vooData.json",
    "check-for-missing": "node ./src/csv/csvCheckForMissing.js",
    "delete-staging": "trash stockDataStaging.json vooDataStaging.json",
    "prettyStocks": "prettier --write \"{stockData,vooData,stockDataStaging,vooDataStaging,stockDataMeta}.json\"",
    "test": "jest",
    "test-historical-prices": "jest ./test/historicalPrices.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/jest": "^26.0.21",
    "chalk": "^4.1.0",
    "cheerio": "^1.0.0-rc.5",
    "csv-parser": "^3.0.0",
    "himalaya": "^1.1.0",
    "jest": "^29.6.2",
    "jsdom": "^21.0.0",
    "lodash": "^4.17.21",
    "merge-img": "^2.1.3",
    "moment": "^2.29.4",
    "open": "^8",
    "puppeteer-core": "^18.0.5"
  },
  "devDependencies": {
    "eslint": "^7.21.0"
  },
  "eslintConfig": {
    "env": {
      "es2021": true,
      "node": true,
      "jest": true
    },
    "globals": {
      "ARGUS_ANALYST_TIMEOUT": true,
      "BOA_TIMEOUT": true,
      "CFRA_TIMEOUT": true,
      "CONNECTION": true,
      "NO_FETCH_STOCKS": true,
      "CacheService": true,
      "XPATH_TIMEOUT": true,
      "WSJ_TIMEOUT": true,
      "DEFAULT_NAVIGATION_TIMEOUT": true,
      "FIDELITY_ANALYST_TIMEOUT": true,
      "META_LOCATION": true,
      "MOODYS_TIMEOUT": true,
      "MORNINGSTAR_TIMEOUT": true,
      "NEW_CONSTRUCTS_TIMEOUT": true,
      "PAUSE_MS": true,
      "SCRAPBOOK_LOCATION": true,
      "STOCK_DATA_LOCATION": true,
      "STOCK_DATA_STAGING": true,
      "VOO_DATA_STAGING": true,
      "SpreadsheetApp": true,
      "TD_TIMEOUT": true,
      "TIPRANKS_TIMEOUT": true,
      "VOO_LOCATION": true,
      "fetch": true,
      "fs": true,
      "test": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "rules": {
      "no-console": "off",
      "no-unused-vars": "warn"
    }
  },
  "prettier": {
    "singleQuote": false,
    "semi": false,
    "printWidth": 95,
    "arrowParens": "avoid"
  }
}
