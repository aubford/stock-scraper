{
  "name": "stock-scraper",
  "version": "1.0.0",
  "description": "",
  "main": "src/apps/start.js",
  "scripts": {
    "init": "ln -s \"$STOCK_SCRAPBOOK_LOCATION/stockData.json\" ./stockData.json; ln -s \"$STOCK_SCRAPBOOK_LOCATION/stockDataMeta.json\" ./stockDataMeta.json; ln -s \"$STOCK_SCRAPBOOK_LOCATION/vooData.json\" ./vooData.json",
    "start": "npm run prerun && node --require ./preload.js ./src/apps/start.js && npm run prettyStock",
    "voo": "npm run prerun && node --require ./preload.js ./src/apps/fetchVoo.js && npm run prettyVoo",
    "update": "npm run prerun && node --require ./preload.js src/apps/update.js && npm run prettyStock",
    "update-yahoo-wsj": "node --require ./preload.js ./src/apps/updateYahooWsj.js && npm run prettyStock",
    "voo-update-yahoo-wsj": "node --require ./preload.js ./src/apps/updateYahooWsjForVoo.js && npm run prettyStock",
    "update-analyst": "npm run prerun && node --require ./preload.js ./src/apps/updateAnalyst.js && npm run prettyStock",
    "extra": "npm run prerun && node --require ./preload.js ./src/apps/scrapeExtraData.js && npm run prettyStock",
    "check": "node --eval \"console.log(Boolean(require('$STOCK_SCRAPBOOK_LOCATION/stockData.json')[process.argv[1]]))\"",
    "earnings": "node --require ./src/database/getDatabaseInfo.js --eval 'getEarnings()'",
    "uplog": "node --require ./src/database/getDatabaseInfo.js --eval 'getSectorUpdated()'",
    "sectors": "node --require ./src/database/getDatabaseInfo.js --eval 'getSectorMap()'",
    "reset-db": "src/database/reset-db.sh",
    "backup-db": "src/database/backup-db.sh",
    "revert-db": "cp \"$STOCK_SCRAPBOOK_LOCATION/stockDataBackup.json\" \"$STOCK_SCRAPBOOK_LOCATION/stockData.json\"",
    "start-over": "npm run reset-db && npm run add && npm run update-yahoo-wsj && npm run extra && npm run update",
    "add-tickers": "node --require ./preload.js ./src/database/addTickers.js && npm run prettyStock",
    "migrate": "node --require ./preload.js ./src/database/migrations.js && npm run prettyStock",
    "prune-tickers": "node --require ./preload.js ./src/database/pruneTickers.js && npm run prettyStock",
    "test": "jest",
    "makeTestData": "node --require ./preload.js test/makeTestData.node.js",
    "launch": "killall Google\\ Chrome; /Applications/Google\\ Chrome.app/Contents/MacOS/Google\\ Chrome --remote-debugging-port=9222 --no-first-run --no-default-browser-check --disable-features=IsolateOrigins,site-per-process",
    "prettyStock": "prettier --write \"$STOCK_SCRAPBOOK_LOCATION/stockData.json\"",
    "prettyVoo": "prettier --write \"$STOCK_SCRAPBOOK_LOCATION/vooData.json\"",
    "prerun": "nvm use; curl localhost:9222/json/version > ws.json",
    "sandbox": "npm run prerun && node --require ./preload.js test/puppeteerSandbox.node.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/jest": "^26.0.21",
    "chalk": "^4.1.0",
    "cheerio": "^1.0.0-rc.5",
    "himalaya": "^1.1.0",
    "jest": "^26.6.3",
    "jsdom": "^21.0.0",
    "lodash": "^4.17.20",
    "merge-img": "^2.1.3",
    "moment": "^2.29.1",
    "node-fetch": "^2.6.1",
    "puppeteer-core": "^18.0.5"
  },
  "devDependencies": {
    "eslint": "^7.21.0"
  },
  "eslintConfig": {
    "env": {
      "es2021": true,
      "node": true,
      "jest": true
    },
    "globals": {
      "fs": true,
      "fetch": true,
      "test": true,
      "SHOULD_MERGE": true,
      "ARGUS_ANALYST_KEY": true,
      "ARGUS_RESEARCH_KEY": true,
      "ZACKS_KEY": true,
      "XPATH_TIMEOUT": true,
      "FIDELITY": true,
      "NEW_CONSTRUCTS_TIMEOUT": true,
      "TIPRANKS_TIMEOUT": true,
      "FORD_TIMEOUT": true,
      "ZACKS_TIMEOUT": true,
      "FIDELITY_STATS_TIMEOUT": true,
      "FIDELITY_ANALYST_TIMEOUT": true,
      "MOODYS_TIMEOUT": true,
      "CFRA_TIMEOUT": true,
      "BOA_TIMEOUT": true,
      "MORNINGSTAR_TIMEOUT": true,
      "ARGUS_RESEARCH_TIMEOUT": true,
      "ARGUS_ANALYST_TIMEOUT": true,
      "DEFAULT_NAVIGATION_TIMEOUT": true,
      "FORD": true,
      "NEW_CONSTRUCTS": true,
      "THE_STREET": true,
      "ARGUS_ANALYST": true,
      "ARGUS_RESEARCH": true,
      "ZACKS": true,
      "MORNINGSTAR": true,
      "CFRA": true,
      "BOA": true,
      "SCRAPBOOK_LOCATION": true,
      "META_LOCATION": true,
      "PAUSE_MS": true,
      "STOCK_DATA_LOCATION": true,
      "STOCK_DATA_BACKUP_LOCATION": true,
      "VOO_LOCATION": true,
      "YAHOO_MODULES": true,
      "CONNECTION": true,
      "FIDELITY_STATS": true,
      "TIPRANKS": true,
      "TD": true,
      "TD_TIMEOUT": true,
      "BAD_FETCHES": true,
      "SpreadsheetApp": true,
      "PropertiesService": true,
      "LodashGS": true,
      "CacheService": true,
      "DriveApp": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "rules": {
      "no-console": "off"
    }
  },
  "prettier": {
    "singleQuote": false,
    "semi": false,
    "printWidth": 95,
    "arrowParens": "avoid"
  }
}
