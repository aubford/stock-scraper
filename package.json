{
  "name": "stock-scraper",
  "version": "1.0.0",
  "description": "",
  "main": "src/apps/start.js",
  "scripts": {
    "all": "npm run extra && npm run csv && npm run update && npm run voo && npm run vooB",
    "daily-update": "caffeinate & jest ./test/historicalPrices.test.js && node --require ./preload.js ./src/apps/dailyUpdate.js && sleep 180 && node --require ./preload.js ./src/apps/dailyUpdate.js --voo && npm run prettyStock && npm run prettyVoo && killall caffeinate",
    "voo-daily-update": "node --require ./preload.js ./src/apps/dailyUpdate.js --voo && npm run prettyStock && npm run prettyVoo",
    "update": "node --require ./preload.js src/apps/update.js",
    "csv": "node --require ./preload.js ./src/csv/processCSVs.js && npm run prettyStock",
    "init": "ln -s \"$STOCK_SCRAPBOOK_LOCATION/stockData.json\" ./stockData.json; ln -s \"$STOCK_SCRAPBOOK_LOCATION/stockDataMeta.json\" ./stockDataMeta.json; ln -s \"$STOCK_SCRAPBOOK_LOCATION/vooData.json\" ./vooData.json",
    "voo": "node --require ./preload.js src/apps/voo/fetchVoo.js && npm run prettyVoo",
    "vooB": "node --require ./preload.js src/apps/voo/fetchVooB.js && npm run prettyVoo",
    "launch": "node ./launch.js",
    "check-for-missing": "node ./src/csv/check-for-missing.js",
    "check": "node --eval \"console.log(require('$STOCK_SCRAPBOOK_LOCATION/stockData.json')[process.argv[1]])\"",
    "checkv": "node --eval \"console.log(require('$STOCK_SCRAPBOOK_LOCATION/vooData.json')[process.argv[1]])\"",
    "add-tickers": "node --require ./preload.js ./src/database/addTickers.js && npm run prettyStock",
    "voo-add-tickers": "node --require ./preload.js ./src/database/vooAddTickers.js && npm run prettyStock",
    "prune-tickers": "node --require ./preload.js ./src/database/pruneTickers.js && npm run prettyStock && npm run check-for-missing",
    "backup-db": "src/database/backup-db.sh",
    "prettyStock": "prettier --write \"$STOCK_SCRAPBOOK_LOCATION/stockData.json\"",
    "prettyVoo": "prettier --write \"$STOCK_SCRAPBOOK_LOCATION/vooData.json\"",
    "sandbox": "node --require ./preload.js test/puppeteerSandbox.node.js",
    "sectors": "node --require ./src/database/getDatabaseInfo.js --eval 'getSectorMap()'",
    "start": "node --require ./preload.js ./src/apps/start.js && npm run prettyStock",
    "test": "jest",
    "uplog": "node --require ./src/database/getDatabaseInfo.js --eval 'getSectorUpdated()'",
    "update-fidelity": "node --require ./preload.js ./src/apps/updateFidelity.js && npm run prettyStock",
    "update-merill": "node --require ./preload.js ./src/apps/updateMerill.js && npm run prettyStock",
    "update-zacks": "node --require ./preload.js ./src/apps/updateZacks.js && npm run prettyStock",
    "voo-update-zacks": "node --require ./preload.js src/apps/voo/updateZacksForVoo.js && npm run prettyStock",
    "extra": "node --require ./preload.js ./src/apps/scrapeExtraData.js && npm run prettyStock",
    "test-historical-prices": "jest ./test/historicalPrices.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/jest": "^26.0.21",
    "chalk": "^4.1.0",
    "cheerio": "^1.0.0-rc.5",
    "csv-parser": "^3.0.0",
    "himalaya": "^1.1.0",
    "jest": "^29.6.2",
    "jsdom": "^21.0.0",
    "lodash": "^4.17.21",
    "merge-img": "^2.1.3",
    "moment": "^2.29.4",
    "open": "^8",
    "puppeteer-core": "^18.0.5"
  },
  "devDependencies": {
    "eslint": "^7.21.0"
  },
  "eslintConfig": {
    "env": {
      "es2021": true,
      "node": true,
      "jest": true
    },
    "globals": {
      "ARGUS_ANALYST": true,
      "ARGUS_ANALYST_KEY": true,
      "ARGUS_ANALYST_TIMEOUT": true,
      "ARGUS_RESEARCH": true,
      "ARGUS_RESEARCH_KEY": true,
      "ARGUS_RESEARCH_TIMEOUT": true,
      "BAD_FETCHES": true,
      "BOA": true,
      "BOA_TIMEOUT": true,
      "CFRA": true,
      "CFRA_TIMEOUT": true,
      "CONNECTION": true,
      "CacheService": true,
      "DEFAULT_NAVIGATION_TIMEOUT": true,
      "DriveApp": true,
      "FIDELITY": true,
      "FIDELITY_ANALYST_TIMEOUT": true,
      "FIDELITY_STATS": true,
      "FIDELITY_STATS_TIMEOUT": true,
      "LodashGS": true,
      "META_LOCATION": true,
      "MOODYS": true,
      "MOODYS_TIMEOUT": true,
      "MORNINGSTAR": true,
      "MORNINGSTAR_TIMEOUT": true,
      "NEW_CONSTRUCTS": true,
      "NEW_CONSTRUCTS_TIMEOUT": true,
      "PAUSE_MS": true,
      "PropertiesService": true,
      "SCRAPBOOK_LOCATION": true,
      "SHOULD_MERGE": true,
      "STOCK_DATA_BACKUP_LOCATION": true,
      "STOCK_DATA_LOCATION": true,
      "SpreadsheetApp": true,
      "TD": true,
      "TD_TIMEOUT": true,
      "TIPRANKS": true,
      "TIPRANKS_TIMEOUT": true,
      "VOO_LOCATION": true,
      "XPATH_TIMEOUT": true,
      "YAHOO": true,
      "YAHOO_PRICES": true,
      "YAHOO_MODULES": true,
      "ZACKS": true,
      "ZACKS_KEY": true,
      "ZACKS_TIMEOUT": true,
      "fetch": true,
      "fs": true,
      "test": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "rules": {
      "no-console": "off",
      "no-unused-vars": "warn"
    }
  },
  "prettier": {
    "singleQuote": false,
    "semi": false,
    "printWidth": 95,
    "arrowParens": "avoid"
  }
}
